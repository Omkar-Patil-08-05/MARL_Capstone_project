# ============================================================
# MARL Capstone - Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# -------------------------
# ROS 2 workspaces
# -------------------------
drone_ws/build/
drone_ws/install/
drone_ws/log/

# ROS generated/cache files
**/.colcon/
**/.ros/

# -------------------------
# Training/runtime results
# -------------------------
marl_drone_project/results/
marl_drone_project/**/__pycache__/
results/
drone_ws/results/
analysis/outputs/
*.pt


# -------------------------
# Temporary logs
# -------------------------
*.log
*.tmp
*.bak
test_log.txt
blender_output.txt

# -------------------------
# Large/generated Blender files
# -------------------------
*.blend1

# -------------------------
# Generic downloaded asset collection
# -------------------------
assets/

# -------------------------
# External dependency repositories
# -------------------------
external_worlds/

# Micro-XRCE-DDS-Agent is an external dependency.
# We don't vendor its source/build tree into the capstone repo.
tools/

# -------------------------
# Generated/cache artifacts
# -------------------------
*.pyc
*.egg-info/
*.egg-info/*
.pytest_cache/

# -------------------------
# OS / editor
# -------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Blender source/project files are not required for Gazebo runtime
*.blend

# Node / React
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*