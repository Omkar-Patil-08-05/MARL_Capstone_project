<?xml version="1.0" ?>
<sdf version="1.6">
    <model name="rescue_randy_standing">
        <static>true</static>
        <link name="link">
            <!-- Rescue Randy manikin model:
                 The rescue_randy.dae mesh origin is at Z≈+0.624m relative to its base.
                 A pose offset of Z=-0.624m places the base directly on the ground (Z=0).
                 Collision box (0.65m x 0.60m x 0.85m centered at Z=0.425m) accurately bounds
                 the physical manikin geometry for contact and raycast detection. -->
            <pose>0 0 -0.623996 0 0 0</pose>
            <collision name="body_collision">
                <pose>0 0 0.425 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.65 0.60 0.85</size>
                    </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/rescue_randy.dae</uri>
                    </mesh>
                </geometry>
                <!-- gz-sim-thermal-system: attaches a human body heat signature.
                     max_temp=308 K (34.85°C) for consistent thermal sensor detection. -->
                <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
                    <heat_signature>materials/textures/RescueRandy_Thermal.png</heat_signature>
                    <max_temp>308</max_temp>
                </plugin>
            </visual>
        </link>
    </model>
</sdf>
