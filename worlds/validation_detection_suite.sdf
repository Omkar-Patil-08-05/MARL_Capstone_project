<?xml version="1.0"?>
<sdf version="1.9">
<world name="validation_suite">
  <physics type="ode">
    <max_step_size>0.004</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>
  <gravity>0 0 -9.8</gravity>
  <scene>
    <ambient>0.7 0.7 0.7 1</ambient>
    <background>0.72 0.84 0.97 1</background>
    <grid>false</grid>
  </scene>
  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 200 0 0 0</pose>
    <diffuse>1 1 1 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.3 0.2 -1</direction>
  </light>

  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
      </collision>
      <visual name="visual">
        <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
        <material>
          <ambient>0.48 0.52 0.44 1</ambient>
          <diffuse>0.50 0.55 0.45 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- Scenario 1 & 2: Standing Victim -->
  <include>
    <name>victim_standing</name>
    <uri>model://casual_female</uri>
    <pose>0 0 0 0 0 0</pose>
  </include>

  <!-- Scenario 1: Sitting Victim -->
  <include>
    <name>victim_sitting</name>
    <uri>model://rescue_randy_sitting</uri>
    <pose>15 0 0 0 0 0</pose>
  </include>

  <!-- Scenario 1: Lying Victim -->
  <include>
    <name>victim_lying</name>
    <uri>model://casual_female_lying</uri>
    <pose>30 0 0 0 0 0</pose>
  </include>

  <!-- Scenario 3: Partially Obscured Victim near Tree Canopy -->
  <include>
    <name>victim_obscured</name>
    <uri>model://rescue_randy_standing</uri>
    <pose>45 0 0 0 0 0</pose>
  </include>
  <include>
    <name>tree_occlusion</name>
    <uri>model://tree_model</uri>
    <pose>44.4 0.6 0 0 0 0</pose>
  </include>

  <!-- Scenario 4: Multiple Victims Visible in Single FOV -->
  <include>
    <name>victim_multi_a</name>
    <uri>model://casual_female</uri>
    <pose>60 -1.5 0 0 0 0</pose>
  </include>
  <include>
    <name>victim_multi_b</name>
    <uri>model://rescue_randy_standing</uri>
    <pose>60 1.5 0 0 0 0</pose>
  </include>

  <!-- Scenario 5: (Empty Scene at x=75, y=0, no models) -->

  <!-- Scenario 6: Non-Human Distractors (Vehicle, Rubble, Animal) -->
  <model name="distractor_car">
    <static>true</static>
    <pose>90 -2.5 0.5 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>3.5 1.8 1.4</size></box></geometry>
        <material><diffuse>0.3 0.3 0.8 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>3.5 1.8 1.4</size></box></geometry>
      </collision>
    </link>
  </model>
  <model name="distractor_rubble">
    <static>true</static>
    <pose>90 2.5 0.5 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><cylinder><radius>1.2</radius><length>0.8</length></cylinder></geometry>
        <material><diffuse>0.5 0.4 0.3 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>1.2</radius><length>0.8</length></cylinder></geometry>
      </collision>
    </link>
  </model>
  <model name="distractor_animal">
    <static>true</static>
    <pose>90 0 0.3 0 0 0</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
        <material><diffuse>0.6 0.3 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
      </collision>
    </link>
  </model>

  <!-- Controllable Camera Drone Sensor Platform -->
  <model name="camera_drone">
    <static>true</static>
    <pose>0 0 10 0 1.5707963 0</pose>
    <link name="camera_link">
      <sensor name="camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>40.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
      </sensor>
    </link>
  </model>
</world>
</sdf>
