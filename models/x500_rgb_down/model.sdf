<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_rgb_down'>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Camera Link -->
    <link name="camera_link">
      <pose>0.1 0 0.1 0 1.5707 0</pose> <!-- Slightly forward, pointing straight down -->
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov> <!-- 60 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- Joint connecting camera to the drone body -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

  </model>
</sdf>
