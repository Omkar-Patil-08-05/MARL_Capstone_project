<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_multispectral'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Rigid camera housing mounting both RGB-D and Thermal sensors facing straight down -->
    <link name="camera_link">
      <pose>0.03 0 0 0 1.5707 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.060</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00005</iyy>
          <iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>

      <!-- Main dual-sensor payload housing -->
      <visual name="multispectral/visual/housing">
        <geometry>
          <box>
            <size>0.025 0.06 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- RGB-D optical lens (left aperture) -->
      <visual name="multispectral/visual/rgb_lens">
        <pose>0.015 -0.015 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <visual name="multispectral/visual/rgb_glass">
        <pose>0.014 -0.015 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0079</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.5 0.95</ambient>
          <diffuse>0.4 0.4 0.5 0.95</diffuse>
          <specular>1 1 1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- Thermal Germanium optical lens (right aperture) -->
      <visual name="multispectral/visual/thermal_lens">
        <pose>0.015 0.015 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.25 1.0</ambient>
          <diffuse>0.25 0.25 0.3 1.0</diffuse>
        </material>
      </visual>
      <visual name="multispectral/visual/thermal_glass">
        <pose>0.014 0.015 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0079</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.25 0.15 0.05 0.95</ambient>
          <diffuse>0.3 0.2 0.1 0.95</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <!-- 1. RGB-D Camera Sensor: 640x480 downward-facing RGB and depth streams -->
      <sensor name="camera" type="rgbd_camera">
        <pose>0 -0.015 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>40.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
      </sensor>

      <!-- 2. Radiometric Thermal Infrared Sensor: 320x240 16-bit downward-facing stream -->
      <sensor name="thermal_camera" type="thermal">
        <pose>0 0.015 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L16</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <plugin
          filename="gz-sim-thermal-sensor-system"
          name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>323.15</max_temp>
          <resolution>1.0</resolution>
        </plugin>
      </sensor>

      <gravity>true</gravity>
      <velocity_decay />
    </link>

    <!-- Rigid mount to base_link -->
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0 0 0 0 1.5707 0</pose>
    </joint>

    <!-- Ground-truth pose publisher for swarm tracking and telemetry -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <update_frequency>10</update_frequency>
    </plugin>
  </model>
</sdf>
