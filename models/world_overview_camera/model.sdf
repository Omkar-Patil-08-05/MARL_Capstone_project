<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="world_overview_camera">
    <static>true</static>
    <pose>-185 -25 75 0 0.38 0.785</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <gz_frame_id>world_overview_camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.45</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>1500</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>/world_camera/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
